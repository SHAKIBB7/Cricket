# ==============================================================================
# Cric Scorer Pro — Environment Configuration
# ==============================================================================
# NOTE: Cric Scorer Pro is designed as an Offline-First Progressive Web App.
# Local match scoring, ball-by-ball history, squads, and tournament brackets
# work 100% offline using IndexedDB (Dexie.js) even if cloud keys are not provided.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Authentication & Cloud Firestore (Phase 1)
# ------------------------------------------------------------------------------
# Obtain these configuration variables from Firebase Console:
# 1. Go to https://console.firebase.google.com
# 2. Select your project -> Project Settings (gear icon) -> General
# 3. Under "Your apps", select the Web app (</>) or click "Add app"
# 4. Copy the config values into your local .env.local file:

NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890abcdef"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 2. Google Drive Backup & Restore (Phase 2)
# ------------------------------------------------------------------------------
# Google Cloud OAuth 2.0 Web Client ID:
# 1. Go to Google Cloud Console (https://console.cloud.google.com)
# 2. Select project 'cricket-proo' -> APIs & Services -> Credentials
# 3. Under 'OAuth 2.0 Client IDs', copy the Web Client ID
#    (Ensure Authorized JavaScript origins include: http://localhost:3000 and your production URL)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="687129620648-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# 3. Supabase Legacy Synchronization (Maintained for Backward Compatibility)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Public API Key (safe for browser client-side usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-api-key"
