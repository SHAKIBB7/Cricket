# ==============================================================================
# Cric Scorer Pro — Environment Configuration
# ==============================================================================
# NOTE: Cric Scorer Pro is designed as an Offline-First Progressive Web App.
# Local match scoring, history, and tournament tracking work 100% offline
# using IndexedDB (Dexie.js) even if Supabase keys are not provided.
#
# Provide the keys below to enable cross-device cloud synchronization,
# user authentication, and live match center broadcasting via Supabase.
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Public API Key (safe for browser client-side usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-api-key"
