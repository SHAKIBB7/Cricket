rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: /users/{userId}
// Document ID: Firebase Authentication UID
// Fields:
//   - displayName: string (required, 2-50 characters)
//   - email: string (required, matches auth token email)
//   - photoURL: string | null (optional)
//   - createdAt: string (required, ISO 8601 string, immutable)
//   - updatedAt: string (required, ISO 8601 string)
//   - lastDriveBackupAt: string | null (optional, ISO 8601 timestamp of last Drive backup)
//
// Access Patterns:
//   - Read: Allowed only by document owner (request.auth.uid == userId)
//   - Create: Allowed only by document owner with valid schema
//   - Update: Allowed only by document owner; email and createdAt are immutable
//   - Delete: Disallowed
//
// Collection: /teams/{teamId}
// Document ID: Unique team ID (e.g. team_timestamp_random)
// Fields:
//   - id: string (required, 1-128 chars, matches document ID)
//   - userId: string (required, 1-128 chars, matches owner UID)
//   - name: string (required, 1-100 chars)
//   - captain: string (optional/nullable, <= 100 chars)
//   - manager: string (optional/nullable, <= 100 chars)
//   - players: list of strings (optional, <= 50 elements)
//   - createdAt: string (required, ISO 8601 string, immutable)
//   - updatedAt: string (required, ISO 8601 string)
//
// Access Patterns:
//   - Read: Allowed only by document owner (request.auth.uid == resource.data.userId)
//   - Create: Allowed only by document owner with valid schema
//   - Update: Allowed only by document owner; ownership and createdAt are immutable
//   - Delete: Allowed only by document owner
//
// All other collections:
//   - Default deny: local match scoring remains offline in Dexie IndexedDB
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Checks if the request comes from an authenticated Firebase user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Verifies that the document ID matches the caller's canonical Firebase UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validates the schema and bounds of user profile data
    function isValidUserProfile(data) {
      return data.keys().hasAll(['displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'email', 'photoURL', 'createdAt', 'updatedAt', 'lastDriveBackupAt', 'preferences', 'lastActiveMatchId', 'theme', 'language'])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 50
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048))
        && data.createdAt is string
        && data.createdAt.size() <= 50
        && data.updatedAt is string
        && data.updatedAt.size() <= 50
        && (!('lastDriveBackupAt' in data) || data.lastDriveBackupAt == null || (data.lastDriveBackupAt is string && data.lastDriveBackupAt.size() <= 50))
        && (!('theme' in data) || data.theme == null || (data.theme is string && data.theme in ['light', 'dark', 'sunlight']))
        && (!('language' in data) || data.language == null || (data.language is string && data.language in ['en', 'bn']))
        && (!('lastActiveMatchId' in data) || data.lastActiveMatchId == null || (data.lastActiveMatchId is string && data.lastActiveMatchId.size() <= 128))
        && (!('preferences' in data) || data.preferences == null || data.preferences is map);
    }

    // Isolated user profiles: users/{userId}
    match /users/{userId} {
      // 1. Isolated read access: Users can ONLY read their own profile
      allow read: if isOwner(userId);

      // 2. Initial profile creation upon sign-in
      allow create: if isOwner(userId)
        && isValidUserProfile(request.resource.data)
        && (request.auth.token.email == null || request.resource.data.email == request.auth.token.email);

      // 3. Updating profile: custom display name allowed; createdAt is strictly immutable; email requires auth verification
      allow update: if isOwner(userId)
        && isValidUserProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.email == resource.data.email ||
            (request.auth.token.email != null && request.resource.data.email == request.auth.token.email));

      // 4. Hard deletion disallowed to maintain profile integrity
      allow delete: if false;
    }

    // Validates the schema, field types, and payload size bounds of cricket match documents
    function isValidMatch(data) {
      return data.keys().hasAll(['id', 'userId', 'teamA', 'teamB', 'totalOvers', 'status', 'currentInnings', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'teamA', 'teamB', 'tossWinner', 'tossDecision', 'totalOvers', 'status', 'currentInnings', 'targetScore', 'venue', 'result', 'isPublic', 'scorecard_data', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.teamA is string
        && data.teamA.size() >= 1
        && data.teamA.size() <= 100
        && data.teamB is string
        && data.teamB.size() >= 1
        && data.teamB.size() <= 100
        && (!('tossWinner' in data) || data.tossWinner == null || (data.tossWinner is string && data.tossWinner.size() <= 100))
        && (!('tossDecision' in data) || data.tossDecision == null || (data.tossDecision is string && data.tossDecision.size() <= 20))
        && data.totalOvers is int
        && data.totalOvers >= 1
        && data.totalOvers <= 100
        && data.status is string
        && data.status in ['UPCOMING', 'ONGOING', 'COMPLETED', 'ABANDONED']
        && data.currentInnings is int
        && data.currentInnings >= 1
        && data.currentInnings <= 4
        && (!('targetScore' in data) || data.targetScore == null || (data.targetScore is int && data.targetScore >= 0 && data.targetScore <= 5000))
        && (!('venue' in data) || data.venue == null || (data.venue is string && data.venue.size() <= 200))
        && (!('result' in data) || data.result == null || (data.result is string && data.result.size() <= 500))
        && data.isPublic is bool
        && (!('scorecard_data' in data) || data.scorecard_data is map || (data.scorecard_data is string && data.scorecard_data.size() <= 1000000))
        && data.createdAt is string
        && data.createdAt.size() <= 50
        && data.updatedAt is string
        && data.updatedAt.size() <= 50;
    }

    // Shared public cricket matches for spectators & live broadcast
    match /matches/{matchId} {
      // 1. Read: Public match data readable by spectators; private matches strictly restricted to document owner
      allow read: if resource.data.isPublic == true || isOwner(resource.data.userId);

      // 2. Create: Authenticated users can only create matches they own with valid schema & id match
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.id == matchId
        && isValidMatch(request.resource.data);

      // 3. Update: Only owner can update; ownership (userId), id, and createdAt are strictly immutable
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidMatch(request.resource.data);

      // 4. Delete: Only owner can delete their match
      allow delete: if isOwner(resource.data.userId);
    }

    // Validates the schema, field types, and payload size bounds of cricket squad team documents
    function isValidTeam(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'captain', 'manager', 'players', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && (!('captain' in data) || data.captain == null || (data.captain is string && data.captain.size() <= 100))
        && (!('manager' in data) || data.manager == null || (data.manager is string && data.manager.size() <= 100))
        && (!('players' in data) || (data.players is list && data.players.size() <= 50))
        && data.createdAt is string
        && data.createdAt.size() <= 50
        && data.updatedAt is string
        && data.updatedAt.size() <= 50;
    }

    // User-owned cricket team squads
    match /teams/{teamId} {
      // 1. Read: Owner can read their teams
      allow read: if isOwner(resource.data.userId);

      // 2. Create: Authenticated users can create teams they own with valid schema & id match
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.id == teamId
        && isValidTeam(request.resource.data);

      // 3. Update: Only owner can update; ownership (userId), id, and createdAt are strictly immutable
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidTeam(request.resource.data);

      // 4. Delete: Only owner can delete their team
      allow delete: if isOwner(resource.data.userId);
    }

    // Validates the schema, field types, and payload size bounds of tournament documents
    function isValidTournament(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'format', 'teams', 'fixtures', 'leagueMeetings', 'matchOvers', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'format', 'teams', 'fixtures', 'leagueMeetings', 'matchOvers', 'champion', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.format is string
        && data.format in ['knockout', 'league']
        && data.teams is list
        && data.teams.size() >= 2
        && data.teams.size() <= 64
        && data.fixtures is list
        && data.fixtures.size() <= 500
        && data.leagueMeetings is int
        && data.leagueMeetings >= 1
        && data.leagueMeetings <= 10
        && data.matchOvers is int
        && data.matchOvers >= 1
        && data.matchOvers <= 100
        && (!('champion' in data) || data.champion == null || (data.champion is string && data.champion.size() <= 100))
        && data.createdAt is string
        && data.createdAt.size() <= 50
        && data.updatedAt is string
        && data.updatedAt.size() <= 50;
    }

    // User-owned cricket tournaments and fixtures
    match /tournaments/{tournamentId} {
      // 1. Read: Owner can read their tournaments
      allow read: if isOwner(resource.data.userId);

      // 2. Create: Authenticated users can create tournaments they own with valid schema & id match
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.id == tournamentId
        && isValidTournament(request.resource.data);

      // 3. Update: Only owner can update; ownership (userId), id, and createdAt are strictly immutable
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidTournament(request.resource.data);

      // 4. Delete: Only owner can delete their tournament
      allow delete: if isOwner(resource.data.userId);
    }

    // Validates the schema, field types, and payload size bounds of cricket ground/venue documents
    function isValidGround(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'latitude', 'longitude', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'userId', 'name', 'latitude', 'longitude', 'accuracy',
          'locationSource', 'googlePlaceId', 'address', 'referencePlaceId',
          'referencePlaceName', 'referenceLatitude', 'referenceLongitude',
          'referenceDistanceMeters', 'isProvisional', 'isUserConfirmed',
          'isUserDefined', 'namingSource', 'confidenceScore', 'detectionRadiusMeters',
          'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 200
        && (data.latitude is int || data.latitude is float)
        && data.latitude >= -90.0
        && data.latitude <= 90.0
        && (data.longitude is int || data.longitude is float)
        && data.longitude >= -180.0
        && data.longitude <= 180.0
        && (!('accuracy' in data) || data.accuracy == null || data.accuracy is int || data.accuracy is float)
        && (!('locationSource' in data) || data.locationSource == null || (data.locationSource is string && data.locationSource.size() <= 50))
        && (!('googlePlaceId' in data) || data.googlePlaceId == null || (data.googlePlaceId is string && data.googlePlaceId.size() <= 200))
        && (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 500))
        && (!('referencePlaceId' in data) || data.referencePlaceId == null || (data.referencePlaceId is string && data.referencePlaceId.size() <= 200))
        && (!('referencePlaceName' in data) || data.referencePlaceName == null || (data.referencePlaceName is string && data.referencePlaceName.size() <= 200))
        && (!('referenceLatitude' in data) || data.referenceLatitude == null || data.referenceLatitude is int || data.referenceLatitude is float)
        && (!('referenceLongitude' in data) || data.referenceLongitude == null || data.referenceLongitude is int || data.referenceLongitude is float)
        && (!('referenceDistanceMeters' in data) || data.referenceDistanceMeters == null || data.referenceDistanceMeters is int || data.referenceDistanceMeters is float)
        && (!('isProvisional' in data) || data.isProvisional is bool)
        && (!('isUserConfirmed' in data) || data.isUserConfirmed is bool)
        && (!('isUserDefined' in data) || data.isUserDefined is bool)
        && (!('namingSource' in data) || data.namingSource == null || (data.namingSource is string && data.namingSource.size() <= 50))
        && (!('confidenceScore' in data) || data.confidenceScore == null || data.confidenceScore is int || data.confidenceScore is float)
        && (!('detectionRadiusMeters' in data) || data.detectionRadiusMeters == null || data.detectionRadiusMeters is int || data.detectionRadiusMeters is float)
        && data.createdAt is string
        && data.createdAt.size() <= 50
        && data.updatedAt is string
        && data.updatedAt.size() <= 50;
    }

    // User-owned cricket grounds and venues
    match /grounds/{groundId} {
      // 1. Read: Owner can read their grounds
      allow read: if isOwner(resource.data.userId);

      // 2. Create: Authenticated users can create grounds they own with valid schema & id match
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.id == groundId
        && isValidGround(request.resource.data);

      // 3. Update: Only owner can update; ownership (userId), id, and createdAt are strictly immutable
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidGround(request.resource.data);

      // 4. Delete: Only owner can delete their ground
      allow delete: if isOwner(resource.data.userId);
    }

    // Default deny: Unlisted collections remain disallowed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
